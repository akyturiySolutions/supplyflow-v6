# ════════════════════════════════════════════
#  SupplyFlow V6 Universal — Environment Vars
# ════════════════════════════════════════════

# ── Server ───────────────────────────────────
PORT=3000
APP_URL=https://your-app.onrender.com

# ── WhatsApp Cloud API (Meta Developer Console)
WHATSAPP_TOKEN=your_permanent_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=choose_any_secret_string_for_webhook_verification
APP_SECRET=your_meta_app_secret_for_signature_verification

# ── Admin Dashboard ──────────────────────────
ADMIN_TOKEN=generate_a_strong_random_token_here
ADMIN_EMAIL=admin@yourbusiness.com
ADMIN_PASSWORD=strong_password_here

# ── Business Identity ────────────────────────
BUSINESS_ID=your_unique_business_id
BIZ_NAME=ChemiChemi Halisi
BIZ_SECTOR=water
# Sector options: water | gas | food | milk | retail
BIZ_GREETING=Welcome to *ChemiChemi Halisi* 💧\nFresh spring water delivered to your door!
SUPPORT_PHONE=254712345678

# ── M-Pesa (Safaricom Daraja) ────────────────
MPESA_TILL=6247361
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_KEY=your_daraja_consumer_key
MPESA_SECRET=your_daraja_consumer_secret
MPESA_ENV=sandbox
# Change MPESA_ENV to: production  when going live

# ── Firebase / Firestore (Optional) ─────────
# Leave blank to use in-memory store (fine for single instance)
# Paste your full Firebase service account JSON as one line:
FIREBASE_CONFIG={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Redis (Optional — for multi-instance session store) ──
# REDIS_URL=redis://default:password@redis-host:6379
